# Configurações do Supabase para o Palas Atlas
# Obtenha estas credenciais em: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# Chave administrativa para migração e upload (privada, nunca expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
